{
  "manifest_version": 3,
  "name": "agent-eyes",
  "version": "1.0.0",
  "description": "Accessibility-tree bridge for agent-eyes MCP server — lets AI agents see and control Chrome tabs without screenshots.",

  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "agent-eyes",
    "default_popup": "popup.html"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
